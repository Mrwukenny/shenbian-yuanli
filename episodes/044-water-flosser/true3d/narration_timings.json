{
  "voice": "zh-CN-YunjianNeural",
  "rate": "+0%",
  "gap_ms": 280,
  "sample_rate": 48000,
  "duration": 190.952,
  "segments": [
    {
      "index": 0,
      "id": "sent_000",
      "text": "我是Ken，挑战每天用3分钟带你了解一个身边原理。",
      "start": 0.0,
      "end": 5.328,
      "duration": 5.328
    },
    {
      "index": 1,
      "id": "sent_001",
      "text": "今天：冲牙器靠什么把碎屑冲走。",
      "start": 5.608,
      "end": 9.616,
      "duration": 4.008
    },
    {
      "index": 2,
      "id": "sent_002",
      "text": "有人觉得，水压越大，牙缝就一定越干净。",
      "start": 9.896,
      "end": 14.696,
      "duration": 4.8
    },
    {
      "index": 3,
      "id": "sent_003",
      "text": "其实先别急着加挡，先看看水是怎么出来的。",
      "start": 14.976,
      "end": 19.464,
      "duration": 4.488
    },
    {
      "index": 4,
      "id": "sent_004",
      "text": "常见电动冲牙器的主角，是电机带动的小水泵。",
      "start": 19.744,
      "end": 24.808,
      "duration": 5.064
    },
    {
      "index": 5,
      "id": "sent_005",
      "text": "不是超声波隔空洗牙，水得真正碰到要清洁的地方。",
      "start": 25.088,
      "end": 30.536,
      "duration": 5.448
    },
    {
      "index": 6,
      "id": "sent_006",
      "text": "先拆开机身，认认这条水路。",
      "start": 30.816,
      "end": 34.32,
      "duration": 3.504
    },
    {
      "index": 7,
      "id": "sent_007",
      "text": "水箱存水，吸水管连到泵的入口。",
      "start": 34.6,
      "end": 38.776,
      "duration": 4.176
    },
    {
      "index": 8,
      "id": "sent_008",
      "text": "电池给电机供电，电机再带动泵。",
      "start": 39.056,
      "end": 42.872,
      "duration": 3.816
    },
    {
      "index": 9,
      "id": "sent_009",
      "text": "前面接着导水管，最后连到细喷嘴。",
      "start": 43.152,
      "end": 47.208,
      "duration": 4.056
    },
    {
      "index": 10,
      "id": "sent_010",
      "text": "这里用活塞泵示意，不同型号结构会有差别。",
      "start": 47.488,
      "end": 52.12,
      "duration": 4.632
    },
    {
      "index": 11,
      "id": "sent_011",
      "text": "电机一直转，怎么让水一下一下出来？",
      "start": 52.4,
      "end": 56.432,
      "duration": 4.032
    },
    {
      "index": 12,
      "id": "sent_012",
      "text": "看这只偏心轮，它把转动变成活塞的来回移动。",
      "start": 56.712,
      "end": 61.68,
      "duration": 4.968
    },
    {
      "index": 13,
      "id": "sent_013",
      "text": "第一步，活塞后退，泵腔变大。",
      "start": 61.96,
      "end": 65.704,
      "duration": 3.744
    },
    {
      "index": 14,
      "id": "sent_014",
      "text": "进水单向阀打开，把水从水箱吸进来。",
      "start": 65.984,
      "end": 70.424,
      "duration": 4.44
    },
    {
      "index": 15,
      "id": "sent_015",
      "text": "这时出水阀关闭，减少出口倒流。",
      "start": 70.704,
      "end": 74.784,
      "duration": 4.08
    },
    {
      "index": 16,
      "id": "sent_016",
      "text": "第二步，活塞前推，泵腔变小。",
      "start": 75.064,
      "end": 78.832,
      "duration": 3.768
    },
    {
      "index": 17,
      "id": "sent_017",
      "text": "进水阀关闭，出水阀打开，水被压向喷嘴。",
      "start": 79.112,
      "end": 83.768,
      "duration": 4.656
    },
    {
      "index": 18,
      "id": "sent_018",
      "text": "单向阀，就像只许单向通行的门。",
      "start": 84.048,
      "end": 87.96,
      "duration": 3.912
    },
    {
      "index": 19,
      "id": "sent_019",
      "text": "第三步，水经过细喷嘴，集中到一小片区域。",
      "start": 88.24,
      "end": 92.992,
      "duration": 4.752
    },
    {
      "index": 20,
      "id": "sent_020",
      "text": "泵反复吸水、压水，出口流量周期变化。",
      "start": 93.272,
      "end": 98.168,
      "duration": 4.896
    },
    {
      "index": 21,
      "id": "sent_021",
      "text": "这就是常说的脉冲水流。",
      "start": 98.448,
      "end": 101.712,
      "duration": 3.264
    },
    {
      "index": 22,
      "id": "sent_022",
      "text": "不是喷嘴自己会震，而是背后的泵在有节奏地推。",
      "start": 101.992,
      "end": 107.008,
      "duration": 5.016
    },
    {
      "index": 23,
      "id": "sent_023",
      "text": "画面已放慢，不代表真实频率。",
      "start": 107.288,
      "end": 111.056,
      "duration": 3.768
    },
    {
      "index": 24,
      "id": "sent_024",
      "text": "第四步，水打到牙面、牙缝附近，再带着碎屑流走。",
      "start": 111.336,
      "end": 117.0,
      "duration": 5.664
    },
    {
      "index": 25,
      "id": "sent_025",
      "text": "就像用细水流，冲开碰得到的松散食物残渣。",
      "start": 117.28,
      "end": 122.008,
      "duration": 4.728
    },
    {
      "index": 26,
      "id": "sent_026",
      "text": "也能辅助清洁可接触部位的牙菌斑，效果还看使用方法。",
      "start": 122.288,
      "end": 128.0,
      "duration": 5.712
    },
    {
      "index": 27,
      "id": "sent_027",
      "text": "不是每个角落都能冲到，更不是用水钻牙。",
      "start": 128.28,
      "end": 132.768,
      "duration": 4.488
    },
    {
      "index": 28,
      "id": "sent_028",
      "text": "硬化的牙结石，也不是调高挡就能冲掉的。",
      "start": 133.048,
      "end": 137.632,
      "duration": 4.584
    },
    {
      "index": 29,
      "id": "sent_029",
      "text": "这也解释了，为什么加挡以后更容易溅水。",
      "start": 137.912,
      "end": 142.52,
      "duration": 4.608
    },
    {
      "index": 30,
      "id": "sent_030",
      "text": "不同机器可能调压力、流量或脉冲节奏。",
      "start": 142.8,
      "end": 147.264,
      "duration": 4.464
    },
    {
      "index": 31,
      "id": "sent_031",
      "text": "水打到牙面会飞散，溅得多不等于清得全。",
      "start": 147.544,
      "end": 152.104,
      "duration": 4.56
    },
    {
      "index": 32,
      "id": "sent_032",
      "text": "使用时按说明书，从低挡开始，沿着牙龈线慢慢移动。",
      "start": 152.384,
      "end": 157.976,
      "duration": 5.592
    },
    {
      "index": 33,
      "id": "sent_033",
      "text": "让水能流出来，不要对着一个位置硬冲。",
      "start": 158.256,
      "end": 162.288,
      "duration": 4.032
    },
    {
      "index": 34,
      "id": "sent_034",
      "text": "如果疼痛或者持续出血，先停下来，咨询牙医。",
      "start": 162.568,
      "end": 167.8,
      "duration": 5.232
    },
    {
      "index": 35,
      "id": "sent_035",
      "text": "它是日常清洁的辅助，不能代替刷牙和专业口腔护理。",
      "start": 168.08,
      "end": 173.528,
      "duration": 5.448
    },
    {
      "index": 36,
      "id": "sent_036",
      "text": "记住口诀：电机带泵，单向控流，细嘴出水，清洁靠接触。",
      "start": 173.808,
      "end": 180.36,
      "duration": 6.552
    },
    {
      "index": 37,
      "id": "sent_037",
      "text": "关注身边原理，我是Ken，明天继续带你了解下一个原理。",
      "start": 180.64,
      "end": 185.896,
      "duration": 5.256
    },
    {
      "index": 38,
      "id": "sent_038",
      "text": "你还想接着拆哪个家电？评论区告诉我。",
      "start": 186.176,
      "end": 190.952,
      "duration": 4.776
    }
  ]
}